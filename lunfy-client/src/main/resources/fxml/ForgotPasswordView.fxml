<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.shape.SVGPath?>
<?import javafx.scene.shape.Circle?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="ru.funduruk.controller.ForgotPasswordController"
           fx:id="root" stylesheets="@../css/style.css">

    <BorderPane fx:id="rootPane">

        <top>
            <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="10" styleClass="title-bar">
                <Label text="lunfy" styleClass="title-label-bar"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#minimize" styleClass="button-bar">
                    <graphic>
                        <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                            <Image url="@/image/icon/minimize.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button onAction="#close" styleClass="button-bar">
                    <graphic>
                        <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                            <Image url="@/image/icon/close.png"/>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </top>

        <center>
            <HBox fx:id="mainBox" styleClass="main-box">
                <VBox styleClass="login-box">
                    <HBox alignment="CENTER_LEFT" spacing="10">
                        <StackPane fx:id="backButton"
                                   prefWidth="24" prefHeight="24"
                                   style="-fx-cursor: hand;"
                                   styleClass="button-back">
                            <Circle fx:id="backBg" radius="14"
                                    fill="rgba(255,255,255,0.15)" opacity="0"/>
                            <SVGPath content="M12 4 L6 10 L12 16"
                                     stroke="white" strokeWidth="2" fill="transparent"/>
                        </StackPane>
                        <VBox spacing="2">
                            <Label text="Забыли пароль?" styleClass="title-label"/>
                            <Label text="Введите email, на него придёт код"
                                   styleClass="title-subtitle"/>
                        </VBox>
                    </HBox>

                    <TextField fx:id="emailField" promptText="Email" styleClass="text-field"/>

                    <HBox spacing="10" alignment="CENTER">
                        <Button text="Отправить код" onAction="#handleSend" styleClass="button-login"/>
                    </HBox>

                    <VBox fx:id="statusBox" styleClass="status-box" visible="false" managed="false">
                        <Label fx:id="statusLabel" wrapText="true"/>
                    </VBox>
                </VBox>

                <VBox alignment="CENTER">
                    <ImageView fitWidth="250" fitHeight="250" preserveRatio="true">
                        <Image url="@/image/logo/logo.png"/>
                    </ImageView>
                </VBox>
            </HBox>
        </center>
    </BorderPane>
</StackPane>