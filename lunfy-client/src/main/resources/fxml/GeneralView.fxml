<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ru.funduruk.controller.GeneralController"
            fx:id="generalRoot"
            stylesheets="@../css/general_style.css">

    <!-- TOP BAR -->
    <top>
        <HBox fx:id="titleBar" styleClass="title-bar">
            <Label text="lunfy"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#minimize" styleClass="button-bar">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true"
                               pickOnBounds="true" smooth="true"
                               fx:id="minimizeIcon">
                        <Image url="@/image/icon/minimize.png"/>
                    </ImageView>
                </graphic>
            </Button>

            <Button onAction="#maximize" styleClass="button-bar">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true"
                               pickOnBounds="true" smooth="true"
                               fx:id="maximizeIcon">
                        <Image url="@/image/icon/maximize.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button onAction="#close" styleClass="button-bar">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true"
                               pickOnBounds="true" smooth="true"
                               fx:id="closeIcon">
                        <Image url="@/image/icon/close.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
    </top>

    <!-- MAIN -->
    <center>

        <HBox spacing="10" style="-fx-padding: 10;" styleClass="background-pane">

            <!-- GROUPS -->
            <VBox fx:id="groupsPane"
                  styleClass="groups-pane"
                  prefWidth="60"/>

            <!-- SIDEBAR -->
            <VBox styleClass="sidebar-pane" prefWidth="220">

                <Button text="Friends"
                        fx:id="friendsBtn"
                        onAction="#openFriends"
                        styleClass="friends-btn"/>


                <VBox fx:id="chatListPane"
                      VBox.vgrow="ALWAYS"
                      spacing="6"/>

            </VBox>

            <!-- CONTENT -->
            <StackPane fx:id="contentPane"
                       styleClass="content-pane"
                       HBox.hgrow="ALWAYS"/>

        </HBox>
    </center>

</BorderPane>