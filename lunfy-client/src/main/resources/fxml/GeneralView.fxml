<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ru.funduruk.controller.GeneralController"
            fx:id="generalRoot"
            stylesheets="@../css/general_style.css">

    <!-- TOP BAR -->
    <top>
        <HBox fx:id="titleBar" styleClass="title-bar">
            <Label text="lunfy"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#minimize" styleClass="button-bar">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true"
                               pickOnBounds="true" smooth="true"
                               fx:id="minimizeIcon">
                        <Image url="@/image/icon/minimize.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button onAction="#maximize" styleClass="button-bar">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true"
                               pickOnBounds="true" smooth="true"
                               fx:id="maximizeIcon">
                        <Image url="@/image/icon/maximize.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button onAction="#close" styleClass="button-bar">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true"
                               pickOnBounds="true" smooth="true"
                               fx:id="closeIcon">
                        <Image url="@/image/icon/close.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
    </top>

    <!-- Main  -->
    <center>
        <HBox spacing="10" style="-fx-padding: 10;" styleClass="background-pane">

            <!-- Groups -->
            <VBox fx:id="groupsPane"
                  styleClass="groups-pane"
                  prefWidth="60"/>

            <!-- Sidebar -->
            <VBox styleClass="sidebar-pane" prefWidth="220">
                <Button text="Friends"
                        fx:id="friendsBtn"
                        onAction="#openFriends"
                        styleClass="friends-btn"/>

                <HBox alignment="CENTER_LEFT" style="-fx-padding: 8 4 4 4;">
                    <Label text="ЛИЧНЫЕ СООБЩЕНИЯ" styleClass="section-label"/>
                    <Region HBox.hgrow="ALWAYS"/>
                    <Button fx:id="newGroupDMBtn" text="+" styleClass="new-dm-btn"
                            onAction="#openNewGroupDM"/>
                </HBox>

                <VBox fx:id="chatListPane" spacing="6" VBox.vgrow="ALWAYS"/>

                <HBox fx:id="profilePanel" styleClass="profile-panel" spacing="8"
                      onMouseClicked="#openProfile">
                    <StackPane styleClass="avatar-container">
                        <ImageView fx:id="profileAvatar" fitWidth="36" fitHeight="36"
                                   pickOnBounds="true" preserveRatio="true"/>
                        <StackPane fx:id="statusDot" styleClass="status-dot-online"
                                   maxWidth="10" maxHeight="10"
                                   StackPane.alignment="BOTTOM_RIGHT"/>
                    </StackPane>
                    <VBox spacing="2" VBox.vgrow="ALWAYS">
                        <Label fx:id="profileUsername" text="username" styleClass="profile-name"/>
                        <Label fx:id="profileStatus" text="Online" styleClass="profile-status"/>
                    </VBox>
                </HBox>
            </VBox>

            <!-- Content -->
            <StackPane fx:id="contentPane"
                       styleClass="content-pane"
                       HBox.hgrow="ALWAYS"/>

        </HBox>
    </center>

</BorderPane>
