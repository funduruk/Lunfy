<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="ru.funduruk.controller.LoginController"
           fx:id="root" stylesheets="@../css/style.css" >

<BorderPane fx:id="rootPane">


<top>
        <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="10" styleClass="title-bar">
            <Label text="lunfy" styleClass="title-label"/>
            <Region HBox.hgrow="ALWAYS"/>
            <Button onAction="#minimize" styleClass="button-bar">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true"
                               pickOnBounds="true" smooth="true"
                               fx:id="minimizeIcon">
                        <Image url="@/image/icon/minimize.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button onAction="#maximize" styleClass="button-bar">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true"
                               pickOnBounds="true" smooth="true"
                               fx:id="maximizeIcon">
                        <Image url="@/image/icon/maximize.png"/>
                    </ImageView>
                </graphic>
            </Button>
            <Button onAction="#close" styleClass="button-bar">
                <graphic>
                    <ImageView fitWidth="16" fitHeight="16" preserveRatio="true"
                               pickOnBounds="true" smooth="true"
                               fx:id="closeIcon">
                        <Image url="@/image/icon/close.png"/>
                    </ImageView>
                </graphic>
            </Button>
        </HBox>
    </top>

    <center>
        <HBox fx:id="mainBox" styleClass="main-box">
           <VBox fx:id="loginWrapper">
               <VBox fx:id="loginBox" styleClass="login-box">
                   <HBox alignment="CENTER_LEFT" spacing="8" styleClass="hero-tag-wrap">
                       <Region styleClass="pulse-dot"/>
                       <Label text="ОБЩАЙТЕСЬ БЕЗ ГРАНИЦ" styleClass="hero-tag"/>
                   </HBox>
                   <Label text="С возвращением!" styleClass="title-label"/>
                   <Label text="Войдите в свой аккаунт Lunfy" styleClass="title-subtitle"/>
                <TextField fx:id="usernameField" promptText="Имя пользователя" styleClass="text-field"/>
                <StackPane>
                    <PasswordField fx:id="passwordField" promptText="Пароль" styleClass="password-field"/>
                    <TextField fx:id="passwordVisibleField" promptText="Пароль" styleClass="password-field"
                               visible="false" managed="false"/>
                    <Button fx:id="eyeButton" text="👁" onAction="#togglePasswordVisibility"
                            StackPane.alignment="CENTER_RIGHT"
                            style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0; -fx-font-size: 16px;"/>
                </StackPane>
                <Button fx:id="registerBtn" text="Эй! Ты тут впервые?! Создать аккаунт" onAction="#handleRegister" styleClass="button-register"/>
                <HBox spacing="10" alignment="CENTER">
                    <Button text="Войти" onAction="#handleLogin" styleClass="button-login"/>
                </HBox>
                <VBox fx:id="statusBox" styleClass="status-box" visible="false">
                    <Label fx:id="statusLabel" wrapText="true" style="-fx-text-fill: #ff5c7a;"/>
                </VBox>
            </VBox>
           </VBox>

            <VBox alignment="CENTER">
                <ImageView fx:id="logo" fitWidth="250" fitHeight="250" preserveRatio="true" pickOnBounds="true" smooth="true">
                    <Image url="@/image/logo/logo.png"/>
                </ImageView>
            </VBox>
        </HBox>

    </center>

</BorderPane>
</StackPane>