<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>

<StackPane xmlns:fx="http://javafx.com/fxml" fx:controller="ru.funduruk.controller.ResetPasswordController"
           fx:id="root" stylesheets="@../css/style.css">

    <BorderPane fx:id="rootPane">

        <top>
            <HBox fx:id="titleBar" alignment="CENTER_LEFT" spacing="10" styleClass="title-bar">
                <Label text="lunfy" styleClass="title-label-bar"/>
                <Region HBox.hgrow="ALWAYS"/>
                <Button onAction="#minimize" styleClass="button-bar">
                    <graphic>
                        <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                            <Image url="@/image/icon/minimize.png"/>
                        </ImageView>
                    </graphic>
                </Button>
                <Button onAction="#close" styleClass="button-bar">
                    <graphic>
                        <ImageView fitWidth="16" fitHeight="16" preserveRatio="true">
                            <Image url="@/image/icon/close.png"/>
                        </ImageView>
                    </graphic>
                </Button>
            </HBox>
        </top>

        <center>
            <HBox fx:id="mainBox" styleClass="main-box">
                <VBox styleClass="login-box">
                    <HBox alignment="CENTER_LEFT" spacing="8" styleClass="hero-tag-wrap">
                        <Region styleClass="pulse-dot"/>
                        <Label text="ВОССТАНОВЛЕНИЕ" styleClass="hero-tag"/>
                    </HBox>

                    <Label text="Новый пароль" styleClass="title-label"/>
                    <Label fx:id="subtitleLabel"
                           text="Код отправлен на your@email"
                           styleClass="title-subtitle"
                           wrapText="true"/>

                    <TextField fx:id="codeField"
                               promptText="6-значный код"
                               styleClass="text-field, code-field"/>

                    <StackPane>
                        <PasswordField fx:id="passwordField"
                                       promptText="Новый пароль" styleClass="password-field"/>
                        <TextField fx:id="passwordVisibleField"
                                   promptText="Новый пароль" styleClass="password-field"
                                   visible="false" managed="false"/>
                        <Button fx:id="eyeButton" text="👁" onAction="#togglePasswordVisibility"
                                StackPane.alignment="CENTER_RIGHT"
                                style="-fx-background-color: transparent; -fx-cursor: hand; -fx-padding: 0 10 0 0; -fx-font-size: 16px;"/>
                    </StackPane>

                    <HBox spacing="10" alignment="CENTER">
                        <Button text="Сменить пароль" onAction="#handleReset" styleClass="button-login"/>
                    </HBox>

                    <VBox fx:id="statusBox" styleClass="status-box" visible="false" managed="false">
                        <Label fx:id="statusLabel" wrapText="true"/>
                    </VBox>
                </VBox>

                <VBox alignment="CENTER">
                    <ImageView fitWidth="250" fitHeight="250" preserveRatio="true">
                        <Image url="@/image/logo/logo.png"/>
                    </ImageView>
                </VBox>
            </HBox>
        </center>
    </BorderPane>
</StackPane>