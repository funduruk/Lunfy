<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ru.funduruk.controller.CallController"
            fx:id="callRoot"
            style="-fx-background-color: #1a1730;">

    <!-- Центр: либо аватарки участников, либо демонстрация экрана -->
    <center>
        <StackPane fx:id="centerStack">
            <!-- Аудио-режим: аватарки -->
            <HBox fx:id="participantsBox" alignment="CENTER" spacing="40">
                <VBox alignment="CENTER" spacing="12">
                    <StackPane>
                        <Circle radius="55" style="-fx-fill: #5865f2;"/>
                        <Label fx:id="myInitial" style="-fx-text-fill: white; -fx-font-size: 40px; -fx-font-weight: bold;"/>
                    </StackPane>
                    <Label fx:id="myNameLabel" text="Вы" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
                </VBox>

                <VBox alignment="CENTER" spacing="12">
                    <StackPane>
                        <Circle radius="55" style="-fx-fill: #4752c4;"/>
                        <Label fx:id="peerInitial" style="-fx-text-fill: white; -fx-font-size: 40px; -fx-font-weight: bold;"/>
                    </StackPane>
                    <Label fx:id="peerNameLabel" text="username" style="-fx-text-fill: white; -fx-font-size: 15px;"/>
                </VBox>
            </HBox>

            <!-- Режим демонстрации экрана (поверх, скрыт по умолчанию) -->
            <StackPane fx:id="screenStack" visible="false" managed="false"
                       style="-fx-background-color: black;">
                <ImageView fx:id="screenImageView" preserveRatio="true"/>
            </StackPane>
        </StackPane>
    </center>

    <!-- Верх: статус звонка -->
    <top>
        <VBox alignment="CENTER" style="-fx-padding: 20 0 0 0;">
            <Label fx:id="callStatusLabel" text="Вызов..."
                   style="-fx-text-fill: white; -fx-font-size: 18px; -fx-font-weight: bold;"/>
        </VBox>
    </top>

    <!-- Низ: панель управления -->
    <bottom>
        <HBox fx:id="controlBar" alignment="CENTER" spacing="16" style="-fx-padding: 24;">

            <!-- Входящий: принять/отклонить -->
            <Button fx:id="acceptBtn" text="✓" onAction="#accept"
                    style="-fx-background-color: #3ba55d; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 56; -fx-min-height: 56; -fx-font-size: 22px; -fx-cursor: hand;"/>
            <Button fx:id="rejectBtn" text="✕" onAction="#reject"
                    style="-fx-background-color: #ed4245; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 56; -fx-min-height: 56; -fx-font-size: 22px; -fx-cursor: hand;"/>

            <!-- Активный звонок: mute / экран / завершить -->
            <Button fx:id="muteBtn" text="🎤" onAction="#toggleMute" visible="false" managed="false"
                    style="-fx-background-color: #36344f; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 56; -fx-min-height: 56; -fx-font-size: 20px; -fx-cursor: hand;"/>
            <Button fx:id="screenBtn" text="🖥" onAction="#toggleScreenShare" visible="false" managed="false"
                    style="-fx-background-color: #36344f; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 56; -fx-min-height: 56; -fx-font-size: 20px; -fx-cursor: hand;"/>
            <Button fx:id="endBtn" text="📞" onAction="#end" visible="false" managed="false"
                    style="-fx-background-color: #ed4245; -fx-text-fill: white; -fx-background-radius: 50; -fx-min-width: 56; -fx-min-height: 56; -fx-font-size: 20px; -fx-cursor: hand;"/>
        </HBox>
    </bottom>
</BorderPane>