<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.shape.*?>
<?import javafx.geometry.*?>

<BorderPane xmlns:fx="http://javafx.com/fxml"
            fx:controller="ru.funduruk.controller.CallController"
            fx:id="callRoot"
            styleClass="call-root">

    <center>
        <StackPane fx:id="centerStack" styleClass="call-center">
            <HBox fx:id="participantsBox" alignment="CENTER" spacing="60">
                <VBox alignment="CENTER" spacing="14" styleClass="participant-card">
                    <StackPane styleClass="participant-avatar-wrap">
                        <Circle radius="56" styleClass="participant-avatar"/>
                        <Label fx:id="myInitial" styleClass="participant-initial"/>
                    </StackPane>
                    <Label fx:id="myNameLabel" text="Вы" styleClass="participant-name"/>
                </VBox>

                <VBox alignment="CENTER" spacing="14" styleClass="participant-card">
                    <StackPane styleClass="participant-avatar-wrap">
                        <Circle radius="56" styleClass="participant-avatar-peer"/>
                        <Label fx:id="peerInitial" styleClass="participant-initial"/>
                    </StackPane>
                    <Label fx:id="peerNameLabel" text="username" styleClass="participant-name"/>
                </VBox>
            </HBox>

            <StackPane fx:id="screenStack" visible="false" managed="false" styleClass="screen-stack">
                <ImageView fx:id="screenImageView" preserveRatio="true"/>
            </StackPane>
            <StackPane fx:id="peerVideoStack" visible="false" managed="false"
                       StackPane.alignment="CENTER">
                <ImageView fx:id="peerVideoView" preserveRatio="true"/>
            </StackPane>

            <StackPane fx:id="selfVideoStack" visible="false" managed="false"
                       maxWidth="200" maxHeight="150"
                       StackPane.alignment="BOTTOM_RIGHT"
                       styleClass="self-video-stack">
                <padding><Insets bottom="20" right="20"/></padding>
                <ImageView fx:id="selfVideoView" fitWidth="180" fitHeight="135" preserveRatio="true"/>
            </StackPane>
        </StackPane>
    </center>

    <top>
        <VBox alignment="CENTER" styleClass="call-status-bar">
            <Label fx:id="callStatusLabel" text="Вызов..." styleClass="call-status"/>
        </VBox>
    </top>

    <bottom>
        <HBox fx:id="controlBar" alignment="CENTER" spacing="14" styleClass="call-control-bar">

            <Button fx:id="acceptBtn" text="✓" onAction="#accept" styleClass="call-btn, call-btn-accept"/>
            <Button fx:id="rejectBtn" text="✕" onAction="#reject" styleClass="call-btn, call-btn-reject"/>

            <Button fx:id="muteBtn" text="🎤" onAction="#toggleMute" visible="false" managed="false"
                    styleClass="call-btn, call-btn-control"/>
            <Button fx:id="screenBtn" text="🖥" onAction="#toggleScreenShare" visible="false" managed="false"
                    styleClass="call-btn, call-btn-control"/>
            <Button fx:id="videoBtn" text="📹" onAction="#toggleVideo" visible="false" managed="false"
                    styleClass="call-btn, call-btn-control"/>
            <Button fx:id="toggleModeBtn" text="🗕" onAction="#toggleMode" visible="false" managed="false"
                    styleClass="call-btn, call-btn-control"/>
            <Button fx:id="endBtn" text="📞" onAction="#end" visible="false" managed="false"
                    styleClass="call-btn, call-btn-end"/>
        </HBox>
    </bottom>
</BorderPane>