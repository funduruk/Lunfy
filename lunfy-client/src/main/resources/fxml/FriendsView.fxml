<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>

<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="ru.funduruk.controller.FriendsTabController"
      spacing="0" styleClass="friends-view">

    <!-- Header -->
    <HBox styleClass="friends-header" spacing="12" alignment="CENTER_LEFT">
        <Label text="👥" style="-fx-font-size: 18px;"/>
        <Label text="Друзья" styleClass="friends-title"/>

        <Region HBox.hgrow="ALWAYS"/>

        <!-- Search -->
        <TextField fx:id="searchField"
                   promptText="Найти или добавить — Username#1234"
                   prefWidth="260"
                   styleClass="friends-search"/>
        <Button fx:id="addBtn" text="Добавить друга"
                onAction="#handleAdd"
                styleClass="add-friend-btn"/>
    </HBox>

    <!-- tabs -->
    <HBox styleClass="friends-tabs" spacing="4">
        <Button fx:id="tabAll" text="Все" onAction="#showAll"
                styleClass="friends-tab, friends-tab-active"/>
        <Button fx:id="tabOnline" text="Онлайн" onAction="#showOnline"
                styleClass="friends-tab"/>
        <Button fx:id="tabIncoming" text="Входящие" onAction="#showIncoming"
                styleClass="friends-tab"/>
    </HBox>

    <!-- List -->
    <ScrollPane fitToWidth="true" styleClass="friends-scroll" VBox.vgrow="ALWAYS">
        <VBox fx:id="friendsList" spacing="2" styleClass="friends-list"/>
    </ScrollPane>

</VBox>